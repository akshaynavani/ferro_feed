# All settings are optional; CLI flags override nothing set here only if both are given (flags win).
FERRO_WS_ADDR=0.0.0.0:9000
FERRO_STATS_ADDR=127.0.0.1:9001
FERRO_SOURCE=sim            # sim | ingest
FERRO_INGEST_ADDR=127.0.0.1:9100
FERRO_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOG,BTC-USD,ETH-USD,SOL-USD
FERRO_SIM_RATE=100000       # events/sec, 0 = unthrottled
FERRO_SIM_BATCH=32
# FERRO_SIM_SEED=42
FERRO_RING_CAPACITY=65536   # power of two
FERRO_MAX_BATCH=256
FERRO_MAX_SESSIONS=10000
FERRO_DEFAULT_FORMAT=json   # json | binary
# FERRO_WORKERS=4
RUST_LOG=info
