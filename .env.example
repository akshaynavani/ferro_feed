# Optional configuration. Load with: set -a; source .env; set +a
# Command-line flags take precedence over these variables.

FERRO_WS_ADDR=0.0.0.0:9000
FERRO_STATS_ADDR=127.0.0.1:9001
# sim | ingest
FERRO_SOURCE=sim
FERRO_INGEST_ADDR=127.0.0.1:9100
FERRO_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOG,BTC-USD,ETH-USD,SOL-USD
# events/sec, 0 = unthrottled
FERRO_SIM_RATE=100000
FERRO_SIM_BATCH=32
# FERRO_SIM_SEED=42
# must be a power of two
FERRO_RING_CAPACITY=65536
FERRO_MAX_BATCH=256
FERRO_MAX_SESSIONS=10000
# json | binary
FERRO_DEFAULT_FORMAT=json
# FERRO_WORKERS=4
RUST_LOG=info
